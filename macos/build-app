#!/bin/sh
set -eu
base=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
src="$base/src"
stage=$(mktemp -d "$base/.tcl-app-build.XXXXXX")
trap 'rm -rf "$stage"' EXIT
app="$stage/TCL 遥控器.app"
output="$base/TCL 遥控器.app"
iconset="$stage/Remote.iconset"
arch=$(uname -m)
cache=${TCL_SWIFT_CACHE:-$stage/Modules}

mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources" "$iconset"
cp "$src/Info.plist" "$app/Contents/Info.plist"
if [ -f "$base/../LICENSE" ]; then
    cp "$base/../LICENSE" "$app/Contents/Resources/LICENSE"
elif [ -f "$base/LICENSE" ]; then
    cp "$base/LICENSE" "$app/Contents/Resources/LICENSE"
fi
/usr/bin/swiftc -target "$arch-apple-macos13.0" -module-cache-path "$cache" -O \
    -o "$app/Contents/MacOS/TCLRemote" "$src/TCast.swift" "$src/TCLRemoteApp.swift" "$src/Hotkeys.swift"
/usr/bin/swiftc -module-cache-path "$cache" -o "$stage/generate-icon" "$src/GenerateIcon.swift"
"$stage/generate-icon" "$stage/icon.png"
for size in 16 32 128 256 512; do
    /usr/bin/sips -z "$size" "$size" "$stage/icon.png" --out "$iconset/icon_${size}x${size}.png" >/dev/null
    retina=$((size * 2))
    /usr/bin/sips -z "$retina" "$retina" "$stage/icon.png" --out "$iconset/icon_${size}x${size}@2x.png" >/dev/null
done
/usr/bin/iconutil --convert icns --output "$app/Contents/Resources/Remote.icns" "$iconset"
/usr/bin/codesign --force --sign - "$app"
/usr/bin/codesign --verify --strict "$app"

if [ -d "$output" ]; then mv "$output" "$stage/previous.app"; fi
if ! mv "$app" "$output"; then
    if [ -d "$stage/previous.app" ]; then mv "$stage/previous.app" "$output"; fi
    exit 1
fi
printf '%s\n' "$output"
